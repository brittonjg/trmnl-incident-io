# Enforce LF line endings on text files that the trmnl_preview gem parses.
# Newer trmnl-liquid (>= 0.4) rejects templates with CRLF as "Invalid template encoding".
*.liquid  text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
bin/*     text eol=lf
